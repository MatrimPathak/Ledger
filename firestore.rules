rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only the authenticated owner can read/write their own user doc and subcollections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        // Field-level validation on top of the owner check. Scoped to the
        // 'transactions' and 'creditCardAccounts' subcollections —
        // everything else keeps the original unconditional owner-write
        // behavior. Fields are validated only when present so older/partial
        // writes are never rejected.
        allow create, update: if request.auth != null && request.auth.uid == uid &&
          (subcollection != 'transactions' ||
            isValidTransactionWrite(request.resource.data, uid)) &&
          (subcollection != 'creditCardAccounts' ||
            isValidCreditCardAccountWrite(request.resource.data, uid)) &&
          (subcollection != 'subscriptions' ||
            isValidSubscriptionWrite(request.resource.data, uid));
      }
    }

    function isValidTransactionWrite(data, ownerId) {
      return data.userId == ownerId &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0)) &&
        (!('txnCategory' in data) || data.txnCategory == null || data.txnCategory in [
          'expense', 'income', 'transfer',
          'creditCardPurchase', 'creditCardPayment',
          'refund', 'adjustment'
        ]) &&
        (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in [
          'upi', 'bankTransfer', 'debitCard', 'creditCard', 'cash', 'atm', 'wallet'
        ]) &&
        (!('processingStatus' in data) || data.processingStatus == null || data.processingStatus in [
          'local', 'needsAiReview', 'aiProcessed', 'confirmed', 'rejected'
        ]);
    }

    function isValidCreditCardAccountWrite(data, ownerId) {
      return data.userId == ownerId &&
        (!('currentOutstanding' in data) || data.currentOutstanding is number) &&
        (!('creditLimit' in data) || data.creditLimit is number);
    }

    function isValidSubscriptionWrite(data, ownerId) {
      return data.userId == ownerId &&
        (!('expectedAmount' in data) || data.expectedAmount is number) &&
        (!('kind' in data) || data.kind in [
          'subscription', 'recurringBill', 'recurringIncome', 'recurringTransfer'
        ]) &&
        (!('status' in data) || data.status in [
          'active', 'paused', 'cancelled'
        ]);
    }

    // Learned SMS-parsing templates: shared across every signed-in user,
    // not scoped under /users/{uid} — see lib/models/sms_template.dart.
    // Safe to share because a template is, by construction, never allowed
    // to contain a real amount/name/account number: only a bank's fixed
    // message wording plus placeholder markers, plus a handful of
    // classification fields. No delete — a bad template is corrected by
    // publishing a fresh write to the same deterministic doc id, not by
    // removing history.
    match /smsTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && isValidSmsTemplateWrite(request.resource.data);
      allow delete: if false;
    }

    function isValidSmsTemplateWrite(data) {
      return data.bank is string &&
        data.bankCode is string &&
        data.skeleton is string && data.skeleton.size() > 0 && data.skeleton.size() <= 500 &&
        data.templateConfidence is number &&
        data.templateConfidence >= 0 && data.templateConfidence <= 1 &&
        data.matchCount is number &&
        (!('direction' in data) || data.direction == null || data.direction in ['debit', 'credit']) &&
        (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in [
          'upi', 'bankTransfer', 'debitCard', 'creditCard', 'cash', 'atm', 'wallet'
        ]);
    }
  }
}
